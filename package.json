{
  "name": "interview-api",
  "version": "0.0.1",
  "private": true,
  "description": "NestJS Tree REST API",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\"",
    "test": "jest --config jest.config.ts --runInBand",
    "test:fast": "jest --config jest.config.ts --runInBand test/api-port.spec.ts test/create-tree-node.dto.spec.ts",
    "e2e:blackbox:run": "jest --config jest.blackbox-e2e.config.ts --runInBand",
    "e2e:blackbox": "node scripts/run-blackbox-e2e.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@prisma/client": "^6.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "nestjs-pino": "^4.5.0",
    "pino": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.9",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.3",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^8.57.1",
    "jest": "^30.2.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
