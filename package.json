{
  "name": "interview-api",
  "version": "0.0.1",
  "private": true,
  "description": "NestJS Tree REST API",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\"",
    "test": "jest --config jest.config.ts --runInBand",
    "openapi:snapshot": "UPDATE_OPENAPI_SNAPSHOT=true jest --config jest.config.ts --runInBand test/openapi.snapshot.spec.ts",
    "test:fast": "jest --config jest.config.ts --runInBand test/api-port.spec.ts test/create-tree-node.dto.spec.ts",
    "e2e:blackbox:run": "jest --config jest.blackbox-e2e.config.ts --runInBand",
    "e2e:blackbox": "node scripts/run-blackbox-e2e.mjs",
    "seed:trees": "npx ts-node --transpile-only prisma/seed-trees.ts",
    "load:up": "docker compose up -d --build db migrate api",
    "load:down": "docker compose down -v",
    "load:tree": "REPORT_NAME=\"${REPORT_NAME:-tree-baseline}\"; BASE_URL=\"${BASE_URL:-http://host.docker.internal:3000}\"; VUS=\"${VUS:-25}\"; DURATION=\"${DURATION:-1m}\"; mkdir -p load/k6/results && docker run --rm -i -v \"$PWD/load/k6:/scripts\" -e BASE_URL=\"$BASE_URL\" -e VUS=\"$VUS\" -e DURATION=\"$DURATION\" -e K6_WEB_DASHBOARD=true -e K6_WEB_DASHBOARD_EXPORT=\"/scripts/results/$REPORT_NAME.html\" grafana/k6 run --summary-export \"/scripts/results/$REPORT_NAME.summary.json\" -e BASE_URL=\"$BASE_URL\" -e VUS=\"$VUS\" -e DURATION=\"$DURATION\" /scripts/tree-baseline.js",
    "load:stress": "node scripts/run-local-load-stress.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "nestjs-pino": "^4.5.0",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.9",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.3",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^8.57.1",
    "jest": "^30.2.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
