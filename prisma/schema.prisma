generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TreeNode {
  id       Int       @id @default(autoincrement())
  label    String
  parentId Int?

  parent   TreeNode?  @relation("TreeNodeChildren", fields: [parentId], references: [id])
  children TreeNode[] @relation("TreeNodeChildren")

  @@index([parentId])
}
