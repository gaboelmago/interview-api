# API
API_PORT=3000

# Request body size limit for JSON and urlencoded payloads.
# Examples: 100kb, 1mb
BODY_LIMIT=100kb

# Basic in-app throttling (single-instance / in-memory).
# Defaults:
# - THROTTLE_TTL_SECONDS=60
# - THROTTLE_LIMIT=100
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# GET /api/tree operational caps (Phase 17).
# When set, the API rejects with 400 if exceeded (no truncation).
# Examples:
# - TREE_GET_MAX_NODES=10000
# - TREE_GET_MAX_DEPTH=50
TREE_GET_MAX_NODES=
TREE_GET_MAX_DEPTH=

# Server timeouts (Phase 17 Part C)
# These apply at the Node HTTP server level.
# - SERVER_KEEP_ALIVE_TIMEOUT_MS: idle keep-alive socket timeout
# - SERVER_HEADERS_TIMEOUT_MS: must be > keep-alive timeout (Node requirement)
# - SERVER_REQUEST_TIMEOUT_MS: total request timeout
#
# Defaults:
# - SERVER_KEEP_ALIVE_TIMEOUT_MS=5000
# - SERVER_HEADERS_TIMEOUT_MS=60000
# - SERVER_REQUEST_TIMEOUT_MS=300000
SERVER_KEEP_ALIVE_TIMEOUT_MS=
SERVER_HEADERS_TIMEOUT_MS=
SERVER_REQUEST_TIMEOUT_MS=

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=interview_api
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Prisma
# Prefer a single explicit URL so tooling works consistently.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interview_api?schema=public

# Database timeouts (Phase 17 Part C)
# Optional: if set, injects Postgres statement_timeout via DATABASE_URL `options`.
# Example: DB_STATEMENT_TIMEOUT_MS=500
DB_STATEMENT_TIMEOUT_MS=

# Readiness
# /api/ready returns 200 when DB ping is successful, 503 otherwise.
# Keep this bounded so readiness never hangs.
READY_DB_TIMEOUT_MS=500
